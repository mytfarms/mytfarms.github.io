<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Current Listings | MYT Auctions</title>
  <meta name="description" content="Browse current private treaty listings from MYT Auctions. Equipment, livestock, real estate, and more — serving Colorado and the greater high plains." />

  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --earth:     #3d2b1f;
      --saddle:    #7a4f2d;
      --wheat:     #d4a85a;
      --cream:     #f5efe4;
      --parchment: #ede3d0;
      --sky:       #2c4a6e;
      --white:     #ffffff;
      --text:      #2a1f14;
      --light:     #7a6655;
      --sold-red:  #c0392b;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Source Sans 3', sans-serif;
      background: var(--cream);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ---- HEADER ---- */
    header {
      background: var(--earth);
      padding: 0 2rem;
      position: sticky;
      top: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.3);
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      font-weight: 900;
      color: var(--wheat);
      letter-spacing: 0.02em;
      text-decoration: none;
    }

    nav a {
      color: var(--parchment);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-left: 2rem;
      opacity: 0.85;
      transition: opacity 0.2s, color 0.2s;
      cursor: pointer;
      background: none;
      border: none;
    }
    nav a:hover, nav a.active { opacity: 1; color: var(--wheat); }

    /* ---- PAGE HEADER ---- */
    .page-hero {
      background:
        linear-gradient(160deg, rgba(61,43,31,0.88) 0%, rgba(44,74,110,0.80) 100%),
        url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1600&q=80') center/cover no-repeat;
      padding: 5rem 2rem 4rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .page-hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 60px;
      background: linear-gradient(to bottom, transparent, var(--cream));
    }
    .page-hero-eyebrow {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--wheat);
      margin-bottom: 0.8rem;
    }
    .page-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      font-weight: 900;
      color: var(--white);
      line-height: 1.1;
      margin-bottom: 1rem;
    }
    .page-hero p {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.05rem;
      color: rgba(245,239,228,0.82);
      max-width: 540px;
      margin: 0 auto;
      line-height: 1.7;
    }

    /* ---- LISTINGS SECTION ---- */
    .listings-section {
      padding: 4rem 2rem 5rem;
    }
    .container { max-width: 1100px; margin: 0 auto; }

    .listings-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .listings-count {
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--saddle);
    }
    .listings-contact {
      font-size: 0.88rem;
      color: var(--light);
    }
    .listings-contact a {
      color: var(--saddle);
      font-weight: 600;
      text-decoration: none;
    }
    .listings-contact a:hover { color: var(--earth); }

    /* ---- CARD GRID ---- */
    .listings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }

    .listing-card {
      background: var(--white);
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 2px 16px rgba(61,43,31,0.09);
      border-bottom: 3px solid var(--wheat);
      transition: transform 0.25s, box-shadow 0.25s;
      display: flex;
      flex-direction: column;
    }
    .listing-card:hover { transform: translateY(-4px); box-shadow: 0 10px 32px rgba(61,43,31,0.16); }

    /* Photo with SOLD stamp */
    .card-photo-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 4/3;
      overflow: hidden;
      background: var(--parchment);
      flex-shrink: 0;
    }
    .card-photo-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .listing-card:hover .card-photo-wrap img { transform: scale(1.03); }

    /* SOLD overlay */
    .sold-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.35);
      z-index: 2;
    }
    .sold-stamp {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.8rem, 8vw, 3.8rem);
      font-weight: 900;
      color: var(--sold-red);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: 6px solid var(--sold-red);
      padding: 0.2em 0.5em;
      border-radius: 4px;
      transform: rotate(-18deg);
      text-shadow: 2px 2px 0 rgba(0,0,0,0.4);
      box-shadow: inset 0 0 0 3px rgba(192,57,43,0.3);
      opacity: 0.92;
      user-select: none;
    }

    /* Category badge */
    .card-badge {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      background: var(--earth);
      color: var(--wheat);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.3em 0.7em;
      border-radius: 2px;
      z-index: 1;
    }

    /* Card body */
    .card-body {
      padding: 1.5rem 1.6rem 1rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--earth);
      line-height: 1.25;
      margin-bottom: 0.5rem;
    }
    .card-desc {
      font-size: 0.93rem;
      line-height: 1.65;
      color: var(--light);
      margin-bottom: 1rem;
      flex: 1;
    }

    /* Price */
    .card-price {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem;
      font-weight: 900;
      color: var(--earth);
      letter-spacing: -0.01em;
      margin-bottom: 0.25rem;
    }
    .card-price.sold-price { color: var(--light); text-decoration: line-through; font-size: 1.3rem; }

    .card-location {
      font-size: 0.8rem;
      color: var(--light);
      letter-spacing: 0.05em;
      margin-bottom: 1.2rem;
    }
    .card-location::before { content: '📍 '; }

    /* Card footer */
    .card-footer {
      border-top: 1px solid var(--parchment);
      padding: 1rem 1.6rem 1.4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .card-contact {
      font-size: 0.82rem;
      color: var(--light);
      line-height: 1.5;
    }
    .card-contact a {
      color: var(--saddle);
      font-weight: 600;
      text-decoration: none;
    }
    .card-contact a:hover { color: var(--earth); }

    .btn {
      display: inline-block;
      padding: 0.65rem 1.4rem;
      border-radius: 3px;
      font-family: 'Source Sans 3', sans-serif;
      font-weight: 600;
      font-size: 0.82rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.22s;
      cursor: pointer;
      border: none;
    }
    .btn-primary { background: var(--wheat); color: var(--earth); }
    .btn-primary:hover { background: #c49540; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(0,0,0,0.18); }
    .btn-ghost {
      background: transparent;
      color: var(--saddle);
      border: 1.5px solid var(--saddle);
    }
    .btn-ghost:hover { background: var(--saddle); color: var(--white); }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 5rem 2rem;
    }
    .empty-state p {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.1rem;
      color: var(--light);
      margin-bottom: 1.5rem;
    }

    /* ---- CTA BAND ---- */
    .cta-band {
      background: var(--sky);
      padding: 3.5rem 2rem;
      text-align: center;
    }
    .cta-band h2 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 900;
      color: var(--white);
      margin-bottom: 0.75rem;
    }
    .cta-band p {
      font-family: 'Libre Baskerville', serif;
      font-size: 1rem;
      color: rgba(255,255,255,0.78);
      margin-bottom: 1.8rem;
      line-height: 1.65;
    }

    /* ---- FOOTER ---- */
    footer {
      background: var(--earth);
      padding: 2.5rem 2rem;
      text-align: center;
    }
    footer p { color: rgba(245,239,228,0.5); font-size: 0.82rem; letter-spacing: 0.05em; }
    footer strong { color: var(--wheat); }

    @media (max-width: 600px) {
      .listings-grid { grid-template-columns: 1fr; }
      nav a { margin-left: 1rem; font-size: 0.75rem; }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header>
    <a href="index.html" class="logo" style="display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;">
      <svg width="78" height="38" viewBox="0 0 78 38" style="display:block;margin:0 auto;" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 32 L4 10 Q4 8 6 8 Q9 8 13 30 Q17 8 20 8 Q22 8 22 10 L22 32" stroke="#d4a85a" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <path d="M30 8 L39 20 L48 8 M39 20 L39 32" stroke="#d4a85a" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <path d="M56 8 L74 8 M65 8 L65 32" stroke="#d4a85a" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
      <div style="font-family:'Source Sans 3',sans-serif;font-size:0.6rem;font-weight:600;letter-spacing:0.22em;color:var(--cream);text-transform:uppercase;margin-left:-4px;">Auctions</div>
    </a>
    <nav>
      <a href="index.html#services">Services</a>
      <a href="index.html#why">Why Auction</a>
      <a href="index.html#faq">FAQ</a>
      <a href="listings.html" class="active">Listings</a>
      <a href="about.html">About</a>
      <a href="index.html#contact">Contact</a>
    </nav>
  </header>

  <!-- PAGE HERO -->
  <div class="page-hero">
    <p class="page-hero-eyebrow">MYT Auctions &nbsp;·&nbsp; Private Treaty Sales</p>
    <h1>Current Listings</h1>
    <p>Browse available items for sale. All listings are private treaty — call or text Cade to make a deal.</p>
  </div>

  <!-- LISTINGS -->
  <section class="listings-section">
    <div class="container">
      <div class="listings-meta">
        <p class="listings-count" id="listing-count">Loading listings…</p>
        <p class="listings-contact">Questions? <a href="tel:+17193304280">Call or text Cade: (719) 330-4280</a></p>
      </div>
      <div class="listings-grid" id="listings-grid">
        <!-- Cards injected by JS -->
      </div>
      <div class="empty-state" id="empty-state" style="display:none;">
        <p>No listings available right now. Check back soon or give us a call.</p>
        <a href="tel:+17193304280" class="btn btn-primary">Call (719) 330-4280</a>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <div class="cta-band">
    <h2>Have Something to Sell?</h2>
    <p>We move assets fast and at true market value. Let's talk about your situation.</p>
    <a href="tel:+17193304280" class="btn btn-primary">Call or Text Cade: (719) 330-4280</a>
  </div>

  <!-- FOOTER -->
  <footer>
    <p><strong>MYT Auctions, LLC</strong> &nbsp;·&nbsp; Colorado &amp; the Greater High Plains &nbsp;·&nbsp; <a href="tel:+17193304280" style="color:var(--wheat)">(719) 330-4280</a></p>
    <p style="margin-top:0.5rem">© 2026 MYT Auctions, LLC. All rights reserved.</p>
  </footer>

  <script>
    /* ============================================================
       LISTINGS DATA — EDIT THIS BLOCK TO MANAGE YOUR LISTINGS
       ============================================================

       FIELDS:
         id          — unique slug, used to build the detail page URL (listing-[id].html)
         title       — item name shown on the card
         category    — badge label: "Equipment", "Livestock", "Real Estate", "Vehicle", "Estate", etc.
         shortDesc   — 1–2 sentence teaser shown on the card
         price       — display string, e.g. "$12,500" or "Call for Price"
         location    — city/area, e.g. "Elbert County, CO"
         photo       — URL to the card hero image
         sold        — true = red SOLD stamp; false = active listing
         detailPage  — filename of the detail page, e.g. "listing-demo.html"

       TO ADD A LISTING:   copy one object block, paste it, fill in your values
       TO MARK SOLD:       change  sold: false  →  sold: true
       TO REMOVE:          delete the entire object block (and its trailing comma)
    ============================================================ */
    const LISTINGS = [
      {
        id: "demo-tractor",
        title: "2018 John Deere 6130R Utility Tractor",
        category: "Equipment",
        shortDesc: "1,240 hours, loader ready, PTO, 3-point hitch. Clean machine in excellent working condition.",
        price: "$89,500",
        location: "Elbert County, CO",
        photo: "https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=800&q=80",
        sold: false,
        detailPage: "listing-demo.html"
      },
      {
        id: "demo-cattle",
        title: "25-Head Angus Cow/Calf Pairs",
        category: "Livestock",
        shortDesc: "Spring-calved pairs, cows averaging 1,100 lbs. Vaccinated, pregnancy tested, ready to go.",
        price: "$62,500",
        location: "Lincoln County, CO",
        photo: "https://images.unsplash.com/photo-1517022812141-23620dba5c23?w=800&q=80",
        sold: false,
        detailPage: "listing-demo.html"
      },
      {
        id: "demo-realestate",
        title: "160-Acre Dryland Farm, El Paso County",
        category: "Real Estate",
        shortDesc: "Tillable dryland with pivot potential. Good fence, rural water tap, road frontage on two sides.",
        price: "$320,000",
        location: "El Paso County, CO",
        photo: "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&q=80",
        sold: true,
        detailPage: "listing-demo.html"
      }
    ];
    /* ============================================================
       END LISTINGS DATA — don't edit below this line
    ============================================================ */

    function formatCard(item) {
      const soldOverlay = item.sold ? `
        <div class="sold-overlay">
          <div class="sold-stamp">Sold</div>
        </div>` : '';

      const priceClass = item.sold ? 'card-price sold-price' : 'card-price';
      const actionBtn = item.sold
        ? `<span class="btn btn-ghost" style="opacity:0.45;cursor:default;">Sold</span>`
        : `<a href="${item.detailPage}" class="btn btn-primary">View Details</a>`;

      return `
        <div class="listing-card">
          <div class="card-photo-wrap">
            <span class="card-badge">${item.category}</span>
            <img src="${item.photo}" alt="${item.title}" loading="lazy" />
            ${soldOverlay}
          </div>
          <div class="card-body">
            <h2 class="card-title">${item.title}</h2>
            <p class="card-desc">${item.shortDesc}</p>
            <div class="${priceClass}">${item.price}</div>
            <p class="card-location">${item.location}</p>
          </div>
          <div class="card-footer">
            <div class="card-contact">
              Call or text Cade<br>
              <a href="tel:+17193304280">(719) 330-4280</a>
            </div>
            ${actionBtn}
          </div>
        </div>`;
    }

    function renderListings() {
      const grid = document.getElementById('listings-grid');
      const empty = document.getElementById('empty-state');
      const countEl = document.getElementById('listing-count');

      if (!LISTINGS || LISTINGS.length === 0) {
        grid.style.display = 'none';
        empty.style.display = 'block';
        countEl.textContent = '0 listings';
        return;
      }

      const active = LISTINGS.filter(l => !l.sold).length;
      const total  = LISTINGS.length;
      countEl.textContent = `${active} active listing${active !== 1 ? 's' : ''} · ${total} total`;

      grid.innerHTML = LISTINGS.map(formatCard).join('');
    }

    renderListings();
  </script>

</body>
</html>
