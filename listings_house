  <script>
    /* ============================================================
       LISTING DATA — EDIT THIS BLOCK FOR EACH LISTING PAGE
       ============================================================

       FIELDS:
         title       — full item title
         category    — "Equipment", "Livestock", "Real Estate", "Vehicle", "Estate", etc.
         location    — city/county/state
         price       — display string: "$12,500" or "Call for Price"
         sold        — true = SOLD stamp on photos + struck-through price
         photos      — array of image URLs; first is shown by default
         videoUrl    — YouTube/Vimeo embed URL, or "" to hide the video section
                       YouTube embed format: "https://www.youtube.com/embed/VIDEO_ID"
                       Vimeo embed format:   "https://player.vimeo.com/video/VIDEO_ID"
         description — full description; use \n\n between paragraphs
         specs       — array of [label, value] pairs for the specs table
                       set to [] to hide the specs table

       EXAMPLE videoUrl (YouTube):
         videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ"
    ============================================================ */
    const LISTING = {
      title:    "2018 John Deere 6130R Utility Tractor",
      category: "Equipment",
      location: "Elbert County, CO",
      price:    "$89,500",
      sold:     false,

      photos: [
        "https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1200&q=80",
        "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1200&q=80",
        "https://images.unsplash.com/photo-1519074069444-1ba4fff66d16?w=1200&q=80",
        "https://images.unsplash.com/photo-1500480786900-9b5fc2c2b84a?w=1200&q=80"
      ],

      videoUrl: "",

      description: `This 2018 John Deere 6130R is a clean, well-maintained utility tractor with 1,240 hours on the clock. Serviced on schedule throughout its life and shows it — no major mechanical issues, tight hitch, strong hydraulics.

Loader-ready with a full skid steer adapter plate. The 3-point hitch is Category II and works flawlessly. PTO is fully functional at both 540 and 1000 RPM. Cab is air conditioned, heated, and in good shape — one scuff on the right rear corner, otherwise clean.

Has been used exclusively on a small dryland operation in Elbert County. No commercial or contract work. Reason for selling is a farm transition — owner is stepping back from row crop production.

Located near Kiowa, CO. Serious buyers only — no joy rides. Call or text Cade to arrange a showing.`,

      specs: [
        ["Year",         "2018"],
        ["Make / Model", "John Deere 6130R"],
        ["Hours",        "1,240"],
        ["Engine HP",    "130 HP"],
        ["Transmission", "AutoQuad Plus"],
        ["PTO",          "540 / 1000 RPM"],
        ["Hitch",        "Category II 3-Point"],
        ["Loader Ready", "Yes — skid steer adapter plate"],
        ["Cab",          "AC / Heat / Buddy Seat"],
        ["Location",     "Elbert County, CO"]
      ]
    };
    /* ============================================================
       END LISTING DATA — don't edit below this line
    ============================================================ */

    function youtubeThumb(embedUrl) {
      const m = embedUrl.match(/youtube\.com\/embed\/([^?&]+)/);
      return m ? `https://img.youtube.com/vi/${m[1]}/hqdefault.jpg` : null;
    }

    function buildGallery() {
      const mainImg   = document.getElementById('main-photo');
      const strip     = document.getElementById('thumb-strip');
      const overlay   = document.getElementById('sold-overlay');

      // Build photo list — photos + optional video thumbnail
      const items = LISTING.photos.map(url => ({ type: 'photo', src: url }));
      if (LISTING.videoUrl) {
        const vThumb = youtubeThumb(LISTING.videoUrl) || 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=800&q=80';
        items.push({ type: 'video', src: vThumb });
      }

      // Set initial main image
      mainImg.src = items[0].src;
      mainImg.alt = LISTING.title;

      // SOLD overlay
      if (LISTING.sold) overlay.style.display = 'flex';

      // Build thumbnails
      items.forEach((item, i) => {
        const div = document.createElement('div');
        div.className = 'thumb' + (i === 0 ? ' active' : '');
        div.setAttribute('role', 'button');
        div.setAttribute('aria-label', item.type === 'video' ? 'Play video' : `Photo ${i + 1}`);
        div.tabIndex = 0;

        const img = document.createElement('img');
        img.src = item.src;
        img.alt = item.type === 'video' ? 'Video thumbnail' : `Photo ${i + 1}`;
        div.appendChild(img);

        // Video play badge
        if (item.type === 'video') {
          const badge = document.createElement('div');
          badge.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4);font-size:1.2rem;pointer-events:none;';
          badge.textContent = '▶';
          div.style.position = 'relative';
          div.appendChild(badge);
        }

        div.addEventListener('click', () => selectItem(i, items));
        div.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') selectItem(i, items); });
        strip.appendChild(div);
      });
    }

    function selectItem(index, items) {
      const mainImg     = document.getElementById('main-photo');
      const videoSect   = document.getElementById('video-section');
      const videoFrame  = document.getElementById('video-frame');
      const thumbs      = document.querySelectorAll('.thumb');
      const heroWrap    = document.getElementById('gallery-hero');

      thumbs.forEach((t, i) => t.classList.toggle('active', i === index));

      const item = items[index];

      if (item.type === 'video') {
        // Show video, hide still
        mainImg.style.opacity = '0.15';
        videoSect.style.display = 'block';
        videoFrame.src = LISTING.videoUrl + '?autoplay=1';
        heroWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        // Show photo, pause video
        mainImg.style.opacity = '1';
        mainImg.src = item.src;
        if (videoFrame.src !== '') videoFrame.src = '';
        videoSect.style.display = 'none';
      }
    }

    function buildSidebar() {
      document.getElementById('sb-category').textContent = LISTING.category;
      document.getElementById('sb-title').textContent    = LISTING.title;
      document.getElementById('sb-location').textContent = LISTING.location;

      const priceEl = document.getElementById('sb-price');
      const badgeEl = document.getElementById('sb-sold-badge');

      priceEl.textContent = LISTING.price;
      if (LISTING.sold) {
        priceEl.classList.add('sold-price');
        badgeEl.style.display = 'block';
      }

      // Page title
      document.title = `${LISTING.title} | MYT Auctions`;
    }

    function buildDescription() {
      const body = document.getElementById('description-body');
      const paras = LISTING.description.trim().split(/\n\n+/);
      body.innerHTML = paras.map(p => `<p>${p.trim()}</p>`).join('');
    }

    function buildSpecs() {
      if (!LISTING.specs || LISTING.specs.length === 0) return;
      const section = document.getElementById('specs-section');
      const table   = document.getElementById('specs-table');
      section.style.display = 'block';
      table.innerHTML = LISTING.specs.map(([label, val]) =>
        `<tr><td>${label}</td><td>${val}</td></tr>`
      ).join('');
    }

    function buildVideoSection() {
      if (!LISTING.videoUrl) return;
      // Video section is shown/hidden by selectItem; pre-load the label
      document.getElementById('video-section').style.display = 'none';
    }

    // Init
    buildGallery();
    buildSidebar();
    buildDescription();
    buildSpecs();
    buildVideoSection();
  </script>

</body>
</html>
