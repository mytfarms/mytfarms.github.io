<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Listing Detail | MYT Auctions</title>
  <meta name="description" content="Full listing detail from MYT Auctions — Colorado & the Greater High Plains." />

  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --earth:     #3d2b1f;
      --saddle:    #7a4f2d;
      --wheat:     #d4a85a;
      --cream:     #f5efe4;
      --parchment: #ede3d0;
      --sky:       #2c4a6e;
      --white:     #ffffff;
      --text:      #2a1f14;
      --light:     #7a6655;
      --sold-red:  #c0392b;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Source Sans 3', sans-serif;
      background: var(--cream);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ---- HEADER ---- */
    header {
      background: var(--earth);
      padding: 0 2rem;
      position: sticky;
      top: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.3);
    }

    nav a {
      color: var(--parchment);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-left: 2rem;
      opacity: 0.85;
      transition: opacity 0.2s, color 0.2s;
    }
    nav a:hover, nav a.active { opacity: 1; color: var(--wheat); }

    /* ---- BACK BREADCRUMB ---- */
    .breadcrumb {
      background: var(--parchment);
      padding: 0.75rem 2rem;
      border-bottom: 1px solid rgba(122,79,45,0.15);
    }
    .breadcrumb a {
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--saddle);
      text-decoration: none;
      transition: color 0.2s;
    }
    .breadcrumb a:hover { color: var(--earth); }
    .breadcrumb a::before { content: '← '; }

    /* ---- MAIN LAYOUT ---- */
    .detail-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 2rem 5rem;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 3.5rem;
      align-items: start;
    }
    @media (max-width: 860px) {
      .detail-wrap { grid-template-columns: 1fr; gap: 2.5rem; }
    }

    /* ---- LEFT: GALLERY + DESCRIPTION ---- */

    /* --- SOLD STAMP on main image --- */
    .gallery-hero-wrap {
      position: relative;
      width: 100%;
      border-radius: 4px;
      overflow: hidden;
      background: var(--parchment);
      aspect-ratio: 4/3;
      margin-bottom: 0.75rem;
    }
    .gallery-hero-wrap img#main-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: opacity 0.2s;
    }

    /* SOLD overlay on detail page */
    .sold-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.32);
      z-index: 2;
      pointer-events: none;
    }
    .sold-stamp {
      font-family: 'Playfair Display', serif;
      font-size: clamp(3.5rem, 10vw, 6rem);
      font-weight: 900;
      color: var(--sold-red);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: 8px solid var(--sold-red);
      padding: 0.15em 0.45em;
      border-radius: 4px;
      transform: rotate(-18deg);
      text-shadow: 2px 2px 0 rgba(0,0,0,0.4);
      box-shadow: inset 0 0 0 4px rgba(192,57,43,0.25);
      opacity: 0.9;
      user-select: none;
    }

    /* Thumbnail strip */
    .thumb-strip {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scrollbar-width: thin;
      scrollbar-color: var(--wheat) transparent;
    }
    .thumb-strip::-webkit-scrollbar { height: 4px; }
    .thumb-strip::-webkit-scrollbar-thumb { background: var(--wheat); border-radius: 2px; }

    .thumb {
      flex-shrink: 0;
      width: 90px;
      height: 68px;
      border-radius: 3px;
      overflow: hidden;
      cursor: pointer;
      border: 2.5px solid transparent;
      transition: border-color 0.18s, opacity 0.18s;
      opacity: 0.7;
    }
    .thumb:hover { opacity: 1; }
    .thumb.active { border-color: var(--wheat); opacity: 1; }
    .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }

    /* Video section */
    .video-section {
      margin-top: 2rem;
    }
    .video-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--saddle);
      margin-bottom: 0.75rem;
    }
    .video-embed {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      border-radius: 4px;
      overflow: hidden;
      background: #000;
    }
    .video-embed iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    /* Description */
    .description-section { margin-top: 2.5rem; }
    .section-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--saddle);
      margin-bottom: 0.75rem;
    }
    .description-body {
      font-family: 'Libre Baskerville', serif;
      font-size: 1rem;
      line-height: 1.85;
      color: #4a3828;
    }
    .description-body p + p { margin-top: 1em; }

    /* Specs table */
    .specs-section { margin-top: 2.5rem; }
    .specs-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
    .specs-table tr { border-bottom: 1px solid rgba(122,79,45,0.15); }
    .specs-table tr:last-child { border-bottom: none; }
    .specs-table td {
      padding: 0.65rem 0.5rem;
      font-size: 0.93rem;
      vertical-align: top;
    }
    .specs-table td:first-child {
      font-weight: 600;
      color: var(--saddle);
      width: 38%;
      padding-right: 1rem;
    }
    .specs-table td:last-child { color: var(--text); }

    /* ---- RIGHT: SIDEBAR ---- */
    .sidebar {
      position: sticky;
      top: 80px;
    }

    .sidebar-card {
      background: var(--white);
      border-radius: 4px;
      border-top: 5px solid var(--wheat);
      box-shadow: 0 2px 20px rgba(61,43,31,0.1);
      padding: 2rem 1.8rem;
    }

    .sidebar-category {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--saddle);
      margin-bottom: 0.5rem;
    }

    .sidebar-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.45rem;
      font-weight: 900;
      color: var(--earth);
      line-height: 1.25;
      margin-bottom: 0.5rem;
    }

    .sidebar-location {
      font-size: 0.82rem;
      color: var(--light);
      margin-bottom: 1.5rem;
    }
    .sidebar-location::before { content: '📍 '; }

    .price-block { margin-bottom: 1.5rem; }
    .price-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--light);
      margin-bottom: 0.2rem;
    }
    .price-value {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      font-weight: 900;
      color: var(--earth);
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .price-value.sold-price {
      color: var(--light);
      text-decoration: line-through;
      font-size: 1.6rem;
    }
    .sold-badge {
      display: inline-block;
      margin-top: 0.4rem;
      background: var(--sold-red);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.3em 0.75em;
      border-radius: 2px;
    }

    .divider { border: none; border-top: 1px solid var(--parchment); margin: 1.5rem 0; }

    .contact-head {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--earth);
      margin-bottom: 0.4rem;
    }
    .contact-sub {
      font-size: 0.88rem;
      color: var(--light);
      line-height: 1.55;
      margin-bottom: 1.2rem;
    }

    .btn {
      display: block;
      width: 100%;
      padding: 0.9rem 1.4rem;
      border-radius: 3px;
      font-family: 'Source Sans 3', sans-serif;
      font-weight: 600;
      font-size: 0.92rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      text-align: center;
      transition: all 0.22s;
      cursor: pointer;
      border: none;
      margin-bottom: 0.75rem;
    }
    .btn-primary { background: var(--wheat); color: var(--earth); }
    .btn-primary:hover { background: #c49540; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(0,0,0,0.18); }
    .btn-outline {
      background: transparent;
      color: var(--saddle);
      border: 1.5px solid var(--saddle);
    }
    .btn-outline:hover { background: var(--saddle); color: var(--white); }

    .sidebar-note {
      font-size: 0.77rem;
      color: var(--light);
      text-align: center;
      line-height: 1.55;
      margin-top: 0.75rem;
    }

    /* ---- CTA BAND ---- */
    .cta-band {
      background: var(--sky);
      padding: 3.5rem 2rem;
      text-align: center;
    }
    .cta-band h2 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 900;
      color: var(--white);
      margin-bottom: 0.75rem;
    }
    .cta-band p {
      font-family: 'Libre Baskerville', serif;
      font-size: 1rem;
      color: rgba(255,255,255,0.78);
      margin-bottom: 1.8rem;
      line-height: 1.65;
    }
    .btn-cta {
      display: inline-block;
      padding: 0.9rem 2.4rem;
      border-radius: 3px;
      font-family: 'Source Sans 3', sans-serif;
      font-weight: 600;
      font-size: 0.92rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      background: var(--wheat);
      color: var(--earth);
      transition: all 0.22s;
    }
    .btn-cta:hover { background: #c49540; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.25); }

    /* ---- FOOTER ---- */
    footer {
      background: var(--earth);
      padding: 2.5rem 2rem;
      text-align: center;
    }
    footer p { color: rgba(245,239,228,0.5); font-size: 0.82rem; letter-spacing: 0.05em; }
    footer strong { color: var(--wheat); }

    @media (max-width: 600px) {
      nav a { margin-left: 1rem; font-size: 0.75rem; }
      .thumb { width: 72px; height: 54px; }
    }
  </style>
</head>
